# Copy to deploy/gateway.env (gitignored; uploaded by deploy.ps1).
# Optional: without a key the maintenance page still works, monitors are just
# not paused/resumed.

# UptimeRobot "Main API key" (My Settings -> API Settings). It must be the main
# key: read-only and monitor-specific keys cannot pause monitors.
UPTIMEROBOT_API_KEY=

# Optional: only pause these monitor IDs (comma separated). Default: all.
# UPTIMEROBOT_MONITOR_IDS=

# Optional tuning
# PAUSE_LEAD_SECONDS=60      # pause this long before the window starts
# RESUME_DELAY_SECONDS=30    # resume this long after the window ends
