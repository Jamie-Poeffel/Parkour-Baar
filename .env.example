# Copy to `.env` (the only app env file; never commit it).
# Used by: `npm run dev`, `make local`, deploy/deploy.ps1 (uploaded as the
# server's app.env) and scripts/sync-env.mjs (terraform-aws/app-secrets.json).

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Firestore (firebase-admin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Axiom
AXIOM_TOKEN=
AXIOM_DATASET=

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=
